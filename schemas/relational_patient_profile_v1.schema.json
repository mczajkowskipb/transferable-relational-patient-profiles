{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mczajkowskipb/transferable-relational-patient-profiles/main/schemas/relational_patient_profile_v1.schema.json",
  "title": "RelationalPatientProfileArtifact/v1",
  "type": "object",
  "required": [
    "schema",
    "artifact_id",
    "source_dataset",
    "feature_namespace",
    "mapping_hash",
    "preprocessing_hash",
    "config_hash",
    "software_commit",
    "min_score",
    "min_margin",
    "min_executable_coverage",
    "created_prelabel",
    "prototypes"
  ],
  "properties": {
    "schema": {
      "const": "RelationalPatientProfileArtifact/v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "source_dataset": {
      "type": "string",
      "minLength": 1
    },
    "feature_namespace": {
      "type": "string",
      "minLength": 1
    },
    "mapping_hash": {
      "type": "string",
      "minLength": 1
    },
    "preprocessing_hash": {
      "type": "string",
      "minLength": 1
    },
    "config_hash": {
      "type": "string",
      "minLength": 1
    },
    "software_commit": {
      "type": "string",
      "minLength": 1
    },
    "min_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "min_margin": {
      "type": "number",
      "minimum": 0
    },
    "min_executable_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_prelabel": {
      "const": true
    },
    "prototypes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/prototype"
      }
    },
    "transportability_certificate": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "$defs": {
    "relation": {
      "type": "object",
      "required": [
        "feature_a",
        "feature_b",
        "direction",
        "weight"
      ],
      "properties": {
        "feature_a": {
          "type": "string",
          "minLength": 1
        },
        "feature_b": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            ">",
            "<"
          ]
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "within_support": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "contrast": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "prototype": {
      "type": "object",
      "required": [
        "profile_id",
        "relations"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relation"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
